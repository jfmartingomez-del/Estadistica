#--------------------------QUARTILES AND DECILES----------------------
# Quartiles
Q1 <- quantile(data, 0.25, type = 2) ; Q1
Q2 <- quantile(data, 0.50, type = 2) ; Q2
Q3 <- quantile(data, 0.75, type = 2) ; Q3

# InterQuartile Range
IQR <- Q3 - Q1 ; IQR

# Decile x (CHANGE x FOR THE NUMBER THEY ASK)
Dx <- quantile(data, x/10, type = 2) ; Dx
