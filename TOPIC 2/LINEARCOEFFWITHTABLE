#--------------------------CALCULATE LINEAR COEFFICIENT-------------------------
tableCorrelation <- function(table, xValues, yValues){ # Para funcionar, xValues e yValues tienen que tener los valores sin repetir (sort(unique(xOG)) tb con "y").
  
  cov <- tableCovariance(table, xValues, yValues)
  
  varX <- tableVarianceX(table, xValues, yValues)  #Functions in another
  varY <- tableVarianceY(table, xValues, yValues)  #    git file (ALL IN MEANS,VARIANCE AND COV)
  
  r <- cov / (sqrt(varX) * sqrt(varY))
  
  return(r)
}
r <- tableCorrelation(tab, xValues, yValues)
cat("Correlation coefficient =", r, "\n")
