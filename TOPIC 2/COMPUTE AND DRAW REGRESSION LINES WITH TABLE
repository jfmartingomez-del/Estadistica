#----------------------COMPUTE AND DRAW REGRESSION LINES------------------------ xValues e yValues tienen que ser valores in repetir
idx <- which(tab >0 ,arr.ind = TRUE)


pointsOfX <- xValues[idx[,1]]
pointsOfY <- yValues[idx[,2]]

cov   <- tableCovariance(tab, xValues, yValues)

varX <- tableVarianceX(tab, xValues, yValues)
varY <- tableVarianceY(tab, xValues, yValues)
b <- cov / varX
meanX <- tableMeanX(tab, xValues, yValues)
meanY <- tableMeanY(tab, xValues, yValues)
a <- meanY - (b * meanX)


bP <- cov / varY
aP <- meanX - (bP * meanY)

plot(pointsOfX, pointsOfY, xlab = "Height", ylab = "Weight", col = "green",pch=19)
abline(a=a,b=b,col="red") #Y|X
abline(a=-aP/bP ,b=1/bP,col="blue") #X|Y



cat("Y/X: y =",a,"+",b,"x\n")
cat("X/Y: x =",aP,"+",bP,"y\n")
