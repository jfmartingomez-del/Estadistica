#-----------CONDITIONAL DISTRIBUTION (COLUMNS RESTRICTED)-----------------------

cat("Introduce the first column:\n")
first_column <- scan()

cat("Introduce the last column:\n")
last_column <- scan()

# Select the columns
conditional_data <- tab[, first_column:last_column]

# Add the frequencies by rows
conditional_abs <- rowSums(conditional_data)

# Calculate relative frequencies
conditional_rel <- conditional_abs / sum(conditional_abs)

# Show results
cat("Absolute conditional frequencies:\n")
print(conditional_abs)

cat("Relative conditional frequencies:\n")
print(conditional_rel)

