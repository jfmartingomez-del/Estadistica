#----------------------------------------------- FIT A PLANE GIVEN X, Y, Z ------------------------------------------
multipleRegression <- function(x, y, z){
  
  M <- cbind(1, x, y)
  Z <- z
  
  A <- solve(t(M) %*% M) %*% t(M) %*% Z
  
  a <- A[1]
  b <- A[2]
  c <- A[3]
  
  cat("z =", a, "+", b, "x +", c, "y\n")
}
