#---------------------------------CREATE THE TABLE------------------------------
cat("Introduce the values of X:\n")
xValues <- scan()

cat("Introduce the values of Y:\n")
yValues <- scan()

cat("Introduce rows of the table (frequencies):\n")
tab <- matrix(scan(), nrow = length(xValues), byrow = TRUE)

rownames(tab) <- xValues
colnames(tab) <- yValues

# Show table with marginal frequencies
print(addmargins(tab))
