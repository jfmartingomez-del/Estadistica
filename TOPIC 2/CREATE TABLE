#---------------------------------CREATE THE TABLE------------------------------
cat("Introduce the values of X:\n")
xValues <- scan()

cat("Introduce the values of Y:\n")
yValues <- scan()

cat("Introduce rows of the table (frequencies):\n")
table <- matrix(scan(), nrow = length(xValues), byrow = TRUE)

rownames(table) <- xValues
colnames(table) <- yValues

# Show table with marginal frequencies
print(addmargins(table))
#-------------------------------------------------------------------------------
#IF THERE ARE NOT FREQUENCIES:
table <- table(xValues,yValues)
